<fieldset>
    <legend>Mappatura proprietà Omeka → classe Wikibase</legend>
    <p class="field-description">
        Per ogni proprietà Omeka specifica il QID della classe Wikibase
        da usare come filtro. Lascia QID vuoto per nessun filtro.
    </p>

    <table id="mapping-table" class="tablesaw">
        <thead>
            <tr>
                <th>Proprietà Omeka</th>
                <th>QID classi Wikibase (separate da virgola)</th>
                <th>Istanza di</th>
                <th>Precompila</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($mapping as $term => $propConfig): ?>
            <tr>
                <td>
                    <input type="text" name="prop_term[]"
                        value="<?= $this->escapeHtml($term) ?>"
                        placeholder="dcterms:creator">
                </td>
                <td>
                    <input type="text" name="prop_classes[]"
                        value="<?= $this->escapeHtml(implode(',', $propConfig['classes'] ?? [])) ?>"
                        placeholder="Q1640,Q1641">
                </td>
                <td>
                    <input type="text" name="prop_label[]"
                        value="<?= $this->escapeHtml($propConfig['label'] ?? '') ?>"
                        placeholder="es: Autore, Luogo...">
                </td>
                <td>
                    <select name="prop_preload[]">
                        <option value="0" <?= empty($propConfig['preload']) ? 'selected' : '' ?>>No</option>
                        <option value="1" <?= !empty($propConfig['preload']) ? 'selected' : '' ?>>Sì</option>
                    </select>
                </td>
                <td>
                    <button type="button" class="remove-row button small">Rimuovi</button>
                </td>
            </tr>
            <?php endforeach; ?>
        </tbody>
    </table>

    <button type="button" id="add-row" class="button">
        + Aggiungi proprietà
    </button>
</fieldset>

<script>
document.getElementById('add-row').addEventListener('click', function () {
    var tbody = document.querySelector('#mapping-table tbody');
    var row   = document.createElement('tr');
    row.innerHTML =
        '<td><input type="text" name="prop_term[]" placeholder="dcterms:creator"></td>' +
        '<td><input type="text" name="prop_classes[]" placeholder="Q1640,Q1641"></td>' +
        '<td><input type="text" name="prop_label[]" placeholder="es: Autore, Luogo..."></td>' +
        '<td><select name="prop_preload[]"><option value="0">No</option><option value="1">Sì</option></select></td>' +
        '<td><button type="button" class="remove-row button small">Rimuovi</button></td>';
    tbody.appendChild(row);
});

document.addEventListener('click', function (e) {
    if (e.target.classList.contains('remove-row')) {
        e.target.closest('tr').remove();
    }
});
</script>